{
  "name": "pi-mcp-adapter-local",
  "version": "0.1.0",
  "private": true,
  "description": "Lean MCP adapter for Pi that never opens browser windows",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./oauth.ts",
      "import": "./oauth.ts",
      "default": "./oauth.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./metadata-cache": {
      "types": "./dist/metadata-cache.d.ts",
      "import": "./dist/metadata-cache.js",
      "default": "./dist/metadata-cache.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build:public": "tsc -p tsconfig.public.json",
    "prepack": "npm run build:public",
    "typecheck": "tsc --noEmit",
    "test": "node --test no-browser.test.mjs",
    "test:upstream": "node test-runner.mjs",
    "test:vitest": "vitest run",
    "test:public-exports": "npm run build:public && node --test public-exports.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:oauth": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory PI_MCP_ADAPTER_DISABLE_AUTH_CACHE=1 node --import tsx --test --test-concurrency=1 oauth-public-api.test.ts mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
    "test:oauth-provider": "PI_MCP_ADAPTER_TEST_AUTH_STORE=memory PI_MCP_ADAPTER_DISABLE_AUTH_CACHE=1 node --import tsx --test mcp-oauth-provider.test.ts",
    "test:conformance": "bash conformance/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "cli.js",
    "agent-dir.ts",
    "index.ts",
    "error-signal.ts",
    "state.ts",
    "utils.ts",
    "abort.ts",
    "runtime-owner.ts",
    "tool-metadata.ts",
    "ts-shape.ts",
    "search-ranking.ts",
    "tool-approval.ts",
    "init.ts",
    "failure-backoff.ts",
    "proxy-modes.ts",
    "direct-tools.ts",
    "namespace-tools.ts",
    "mcp-references.ts",
    "commands.ts",
    "prompts.ts",
    "onboarding-state.ts",
    "mcp-setup-panel.ts",
    "types.ts",
    "ui-tool-visibility.ts",
    "config.ts",
    "package-mcp-loader.ts",
    "server-manager.ts",
    "request-headers-command.ts",
    "unix-socket-transport.ts",
    "json-schema-validator.ts",
    "session-recovery.ts",
    "sampling-handler.ts",
    "elicitation-handler.ts",
    "tool-registrar.ts",
    "tool-result-renderer.ts",
    "mcp-output-guard.ts",
    "mcp-code.ts",
    "mcp-script-worker.mjs",
    "mcp-probe.ts",
    "agent-plugin-loader.ts",
    "resource-tools.ts",
    "lifecycle.ts",
    "mcp-status.ts",
    "metadata-cache.ts",
    "npx-resolver.ts",
    "oauth-handler.ts",
    "oauth.ts",
    "mcp-auth.ts",
    "mcp-bearer-store.ts",
    "mcp-keyring-helper.cjs",
    "mcp-oauth-provider.ts",
    "mcp-callback-server.ts",
    "mcp-auth-flow.ts",
    "mcp-panel.ts",
    "panel-keys.ts",
    "mcp-trace.ts",
    "logger.ts",
    "errors.ts",
    "skills",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
